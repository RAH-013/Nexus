// use prisma-8

// Better Auth + Nexus
model User {
  id            String   @id
  name          String
  lastname      String?
  username      String?  @unique
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  type          UserType @default(CUSTOMER)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  sessions Session[]
  accounts Account[]

  preferences     UserPreference[]
  actions         UserAction[]
  recommendations Recommendation[]
}

model Session {
  id        String @id
  expiresAt TimestamptzString
  token     String @unique

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString

  ipAddress String?
  userAgent String?

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
}

model Account {
  id                   String @id
  accountId            String
  providerId           String
  userId               String

  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                String?
  password             String?

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_idx")
}

model Verification {
  id         String @id
  identifier String
  value      String
  expiresAt  TimestamptzString

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  @@index([identifier], map: "verification_identifier_idx")
}

enum UserType {
  CUSTOMER
}

// Nexus
model Item {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        ItemType
  releaseYear Int?

  providerIds         ItemProvider[]
  categories          ItemCategory[]
  actions             UserAction[]
  recommendationItems RecommendationItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ItemProvider {
  id Int @id @default(autoincrement())

  item   Item @relation(fields: [itemId], references: [id])
  itemId Int

  provider   Provider
  externalId String

  @@unique([provider, externalId])
  @@index([itemId])
}

enum Provider {
  IMDB
  TMDB
}

enum ItemType {
  MOVIE
  SERIES
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  items       ItemCategory[]
  preferences UserPreference[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ItemCategory {
  item       Item @relation(fields: [itemId], references: [id])
  itemId     Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  @@id([itemId, categoryId])
}

model UserPreference {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  weight Float

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([userId, categoryId])
}

model UserAction {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  item   Item? @relation(fields: [itemId], references: [id])
  itemId Int?

  type        ActionType
  value       Float?
  searchQuery String?

  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model Recommendation {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  algorithm String

  items RecommendationItem[]

  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@index([createdAt])
}

model RecommendationItem {
  id Int @id @default(autoincrement())

  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  recommendationId Int

  item   Item @relation(fields: [itemId], references: [id])
  itemId Int

  score    Float
  position Int

  @@unique([recommendationId, itemId])
  @@index([recommendationId, position])
}

enum ActionType {
  VIEW
  LIKE
  DISLIKE
  RATING
  FAVORITE
  SEARCH
}