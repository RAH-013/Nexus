# Generate a unique value with at least 32 characters for local use.
BETTER_AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8080

POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=nexus

REDIS_URL=redis://redis:6379

# Opcional: URL base de la fuente de contenido (vacío o ausente = la real)
CINEMETA_BASE_URL=

# Opcional: clave de TMDB para la foto y biografía de actores
# (ausente = la vista Actores se queda solo con los datos de Cinemeta)
