# Generate a unique value with at least 32 characters for local use.
BETTER_AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8080

POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=nexus

REDIS_URL=redis://redis:6379

# Opcional: URL base de la fuente de contenido (vacío o ausente = la real)
CINEMETA_BASE_URL=

# Opcional: clave de TMDB para la foto y biografía de actores
# (ausente = la vista Actores se queda solo con los datos de Cinemeta)
TMDB_API_KEY=

# Opcional: URL base de la API de TMDB (vacío o ausente = la real)
TMDB_BASE_URL=

# Opcional: clave de la API de Gemini para las recomendaciones «Para ti»
# (ausente o vacía = «Para ti» responde con el motor heurístico local)
GEMINI_API_KEY=

# Opcional: URL base de la API de Gemini (vacío o ausente = la real)
GEMINI_BASE_URL=

# Opcional: modelos de Gemini para recomendaciones, en orden de preferencia
# (separados por coma; si uno agota su cuota gratis se pasa al siguiente,
# y si se agotan todos se usa la heurística local)
GEMINI_MODELS=gemini-2.5-flash
